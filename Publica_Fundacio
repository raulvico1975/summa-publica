import React, { useState, useEffect, useMemo } from 'react';
import { 
  Menu, X, Home, PenTool, Calendar, Settings, LogOut, 
  Share2, MessageCircle, Send, Clock, CheckCircle, AlertCircle, RefreshCw, Edit3, Trash2, Smartphone
} from 'lucide-react';
import { initializeApp } from 'firebase/app';
import { 
  getAuth, onAuthStateChanged, signInAnonymously, signInWithCustomToken, signOut
} from 'firebase/auth';
import { 
  getFirestore, collection, onSnapshot, addDoc, updateDoc, deleteDoc, doc 
} from 'firebase/firestore';

// --- CONFIGURACIÓN DE FIREBASE ---
const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : {};
const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getFirestore(app);
const appId = typeof __app_id !== 'undefined' ? __app_id : 'fpc-social-app';

// --- CONFIGURACIÓN DE GEMINI API ---
const apiKey = ""; // La clave se inyecta automáticamente en el entorno de ejecución

export default function App() {
  const [user, setUser] = useState(null);
  const [loadingAuth, setLoadingAuth] = useState(true);
  const [currentView, setCurrentView] = useState('dashboard'); // dashboard, generate, schedule, settings
  const [isSidebarOpen, setIsSidebarOpen] = useState(true);
  
  // Estado de Datos (Firestore)
  const [posts, setPosts] = useState([]);
  const [loadingData, setLoadingData] = useState(true);

  // Inicialización de Autenticación
  useEffect(() => {
    const initAuth = async () => {
      try {
        if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
          await signInWithCustomToken(auth, __initial_auth_token);
        } else {
          await signInAnonymously(auth);
        }
      } catch (error) {
        console.error("Error de autenticación:", error);
      }
    };
    initAuth();

    const unsubscribe = onAuthStateChanged(auth, (currentUser) => {
      setUser(currentUser);
      setLoadingAuth(false);
    });
    return () => unsubscribe();
  }, []);

  // Carga de Datos desde Firestore (Reglas estrictas aplicadas)
  useEffect(() => {
    if (!user) return;
    
    setLoadingData(true);
    // Usamos public/data para que si hay varios CMs de la fundación, compartan el panel
    const postsRef = collection(db, 'artifacts', appId, 'public', 'data', 'fpc_social_posts');
    
    const unsubscribe = onSnapshot(postsRef, 
      (snapshot) => {
        const postsData = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
        // Ordenamos en memoria (regla estricta: sin queries complejas de firestore)
        postsData.sort((a, b) => b.createdAt - a.createdAt);
        setPosts(postsData);
        setLoadingData(false);
      },
      (error) => {
        console.error("Error cargando publicaciones:", error);
        setLoadingData(false);
      }
    );

    return () => unsubscribe();
  }, [user]);

  const handleLogout = () => {
    signOut(auth);
  };

  if (loadingAuth) {
    return <div className="min-h-screen flex items-center justify-center bg-stone-50"><RefreshCw className="w-8 h-8 animate-spin text-emerald-600" /></div>;
  }

  if (!user) {
    return <LoginScreen onLogin={() => signInAnonymously(auth)} />;
  }

  return (
    <div className="min-h-screen bg-stone-100 flex font-sans text-stone-800">
      {/* Sidebar */}
      <aside className={`bg-stone-900 text-stone-100 w-64 flex-shrink-0 transition-transform duration-300 ${isSidebarOpen ? 'translate-x-0' : '-translate-x-full'} fixed md:relative z-20 h-full`}>
        <div className="p-4 flex items-center justify-between border-b border-stone-800">
          <div className="flex items-center space-x-2">
            <div className="w-8 h-8 bg-emerald-600 rounded-full flex items-center justify-center font-bold text-white">
              FPC
            </div>
            <span className="font-semibold truncate">Portal CM</span>
          </div>
          <button onClick={() => setIsSidebarOpen(false)} className="md:hidden text-stone-400 hover:text-white">
            <X className="w-5 h-5" />
          </button>
        </div>
        
        <nav className="p-4 space-y-2">
          <SidebarItem icon={<Home/>} label="Dashboard" active={currentView === 'dashboard'} onClick={() => setCurrentView('dashboard')} />
          <SidebarItem icon={<PenTool/>} label="Generar Contenido" active={currentView === 'generate'} onClick={() => setCurrentView('generate')} />
          <SidebarItem icon={<Calendar/>} label="Calendario & Aprobación" active={currentView === 'schedule'} onClick={() => setCurrentView('schedule')} />
          <SidebarItem icon={<Settings/>} label="Configuración Redes" active={currentView === 'settings'} onClick={() => setCurrentView('settings')} />
        </nav>

        <div className="absolute bottom-0 w-full p-4 border-t border-stone-800">
          <button onClick={handleLogout} className="flex items-center space-x-3 text-stone-400 hover:text-white transition-colors w-full p-2 rounded-lg hover:bg-stone-800">
            <LogOut className="w-5 h-5" />
            <span>Cerrar Sesión</span>
          </button>
        </div>
      </aside>

      {/* Main Content */}
      <main className="flex-1 flex flex-col h-screen overflow-hidden">
        {/* Topbar */}
        <header className="bg-white shadow-sm h-16 flex items-center justify-between px-4 z-10 flex-shrink-0">
          <button onClick={() => setIsSidebarOpen(!isSidebarOpen)} className="p-2 text-stone-500 hover:text-stone-700 md:hidden">
            <Menu className="w-6 h-6" />
          </button>
          <div className="flex-1 flex justify-center md:justify-start">
            <h1 className="text-xl font-bold text-emerald-800 hidden md:block">Fundació Pere Casaldàliga</h1>
          </div>
          <div className="flex items-center space-x-3">
            <span className="text-sm font-medium text-stone-600">Community Manager</span>
            <div className="w-8 h-8 bg-amber-500 rounded-full flex items-center justify-center text-white font-bold">
              CM
            </div>
          </div>
        </header>

        {/* Scrollable Content Area */}
        <div className="flex-1 overflow-y-auto p-4 md:p-8">
          {currentView === 'dashboard' && <DashboardView posts={posts} onNavigate={setCurrentView} />}
          {currentView === 'generate' && <GenerateView db={db} appId={appId} onNavigate={setCurrentView} />}
          {currentView === 'schedule' && <ScheduleView posts={posts} db={db} appId={appId} />}
          {currentView === 'settings' && <SettingsView />}
        </div>
      </main>
    </div>
  );
}

// --- COMPONENTES SECUNDARIOS ---

