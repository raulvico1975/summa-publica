function GenerateView({ db, appId, onNavigate }) {
  const [topic, setTopic] = useState('');
  const [platform, setPlatform] = useState('instagram_facebook');
  const [isGenerating, setIsGenerating] = useState(false);
  const [generatedContent, setGeneratedContent] = useState('');
  const [editedContent, setEditedContent] = useState('');
  const [isSaving, setIsSaving] = useState(false);
  const [errorMsg, setErrorMsg] = useState('');

  const handleGenerate = async () => {
    if (!topic.trim()) return;
    setIsGenerating(true);
    setErrorMsg('');
    setGeneratedContent('');
    setEditedContent('');

    const systemPrompt = `
      Eres el Community Manager de la "Fundació Pere Casaldàliga". 
      Tus valores centrales son: la solidaridad, la defensa de los derechos humanos, el apoyo a las comunidades indígenas, el cuidado de la Amazonía, la ecología integral y mantener vivo el legado, las causas y las palabras del obispo Pedro Casaldáliga (liberación, esperanza, justicia social).
      Tu tono es: inspirador, cercano, reflexivo, comprometido, pero también profesional y claro.
      
      Instrucciones:
      Escribe un texto persuasivo y adecuado sobre el tema proporcionado por el usuario.
      Plataforma objetivo: ${platform === 'whatsapp' ? 'Lista de Difusión de WhatsApp. Debe ser un texto más personal, con uso de negritas de whatsapp (*texto*), emojis bien colocados, espaciado que facilite la lectura en móvil, y una llamada a la acción clara para compartir.' : 'Redes Sociales (Instagram/Facebook/X). Debe ser atractivo, visual, usar hashtags relevantes al final (#PereCasaldàliga #Solidaridad #Amazonía, etc.), y fomentar la interacción.'}
      
      IMPORTANTE: Devuelve SOLO el texto de la publicación, sin comentarios adicionales ni explicaciones.
    `;

    try {
      const promptPayload = {
        contents: [{ parts: [{ text: `Tema a tratar:\n${topic}` }] }],
        systemInstruction: { parts: [{ text: systemPrompt }] }
      };

      const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(promptPayload)
      });

      const data = await response.json();
      
      if (data.error) {
         throw new Error(data.error.message || "Error en la API de Gemini");
      }

      const text = data.candidates?.[0]?.content?.parts?.[0]?.text || "No se generó contenido.";
      setGeneratedContent(text);
      setEditedContent(text);

    } catch (err) {
      console.error(err);
      setErrorMsg("Ocurrió un error al generar el contenido. Inténtalo de nuevo.");
    } finally {
      setIsGenerating(false);
    }
  };

  const handleSaveDraft = async () => {
    if (!editedContent.trim()) return;
    setIsSaving(true);
    try {
      const postsRef = collection(db, 'artifacts', appId, 'public', 'data', 'fpc_social_posts');
      await addDoc(postsRef, {
        originalTopic: topic,
        platform: platform,
        content: editedContent,
        status: 'pending', // pending = borrador listo para aprobar
        createdAt: Date.now(),
        scheduledDate: null
      });
      // Reset and go to schedule
      setTopic('');
      setGeneratedContent('');
      onNavigate('schedule');
    } catch (err) {
      console.error(err);
      setErrorMsg("Error al guardar el borrador en la base de datos.");
    } finally {
      setIsSaving(false);
    }
  };

  return (
    <div className="max-w-4xl mx-auto bg-white rounded-xl shadow-sm border border-stone-200 overflow-hidden">
      <div className="bg-emerald-700 p-6 text-white">
        <h2 className="text-2xl font-bold flex items-center"><PenTool className="mr-3"/> Asistente de Redacción IA</h2>
        <p className="text-emerald-100 mt-2">Genera contenido alineado con los valores y la voz de la Fundación.</p>
      </div>

      <div className="p-6 md:p-8 space-y-6">
        {/* Paso 1: Configuración */}
        <div>
          <label className="block text-sm font-bold text-stone-700 mb-2">1. Selecciona el Canal de Difusión</label>
          <div className="flex flex-col sm:flex-row space-y-3 sm:space-y-0 sm:space-x-4">
            <button
              onClick={() => setPlatform('instagram_facebook')}
              className={`flex-1 py-3 px-4 rounded-lg border-2 flex items-center justify-center transition-colors ${
                platform === 'instagram_facebook' ? 'border-emerald-600 bg-emerald-50 text-emerald-800' : 'border-stone-200 text-stone-500 hover:border-stone-300'
              }`}
            >
              <Share2 className="w-5 h-5 mr-2" /> Redes (IG / FB / X)
            </button>
            <button
              onClick={() => setPlatform('whatsapp')}
              className={`flex-1 py-3 px-4 rounded-lg border-2 flex items-center justify-center transition-colors ${
                platform === 'whatsapp' ? 'border-emerald-600 bg-emerald-50 text-emerald-800' : 'border-stone-200 text-stone-500 hover:border-stone-300'
              }`}
            >
              <Smartphone className="w-5 h-5 mr-2" /> WhatsApp (Lista)
            </button>
          </div>
        </div>

        {/* Paso 2: Prompt */}
        <div>
          <label className="block text-sm font-bold text-stone-700 mb-2">2. ¿De qué quieres hablar?</label>
          <textarea
            value={topic}
            onChange={(e) => setTopic(e.target.value)}
            placeholder="Ej: Lanzamiento de la nueva campaña de apadrinamiento de escuelas en la Amazonía. Mencionar que es el momento de la solidaridad y recordar una frase de Pere sobre la esperanza."
            className="w-full border border-stone-300 rounded-lg p-4 h-32 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none resize-none"
          ></textarea>
        </div>

        <button
          onClick={handleGenerate}
          disabled={!topic.trim() || isGenerating}
          className="w-full bg-emerald-600 hover:bg-emerald-700 disabled:bg-stone-300 disabled:cursor-not-allowed text-white font-bold py-3 px-4 rounded-lg transition-colors flex items-center justify-center"
        >
          {isGenerating ? <><RefreshCw className="w-5 h-5 mr-2 animate-spin"/> Generando con Gemini...</> : 'Generar Propuesta'}
        </button>

        {errorMsg && (
          <div className="p-4 bg-red-50 text-red-700 rounded-lg flex items-center">
            <AlertCircle className="w-5 h-5 mr-2 flex-shrink-0" />
            <p>{errorMsg}</p>
          </div>
        )}

        {/* Paso 3: Edición */}
        {generatedContent && (
          <div className="mt-8 pt-8 border-t border-stone-200 animate-fadeIn">
            <label className="block text-sm font-bold text-stone-700 mb-2">3. Revisa y Edita el Contenido</label>
            <p className="text-sm text-stone-500 mb-4">Puedes ajustar el texto manualmente antes de guardarlo para su aprobación.</p>
            
            <textarea
              value={editedContent}
              onChange={(e) => setEditedContent(e.target.value)}
              className="w-full border border-stone-300 rounded-lg p-4 h-64 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none text-stone-800 font-medium"
            ></textarea>

            <div className="flex justify-end mt-4">
              <button
                onClick={handleSaveDraft}
                disabled={isSaving || !editedContent.trim()}
                className="bg-stone-800 hover:bg-stone-900 text-white font-bold py-3 px-8 rounded-lg transition-colors flex items-center disabled:opacity-50"
              >
                {isSaving ? 'Guardando...' : <><CheckCircle className="w-5 h-5 mr-2"/> Guardar Borrador</>}
              </button>
            </div>
          </div>
        )}
      </div>
    </div>
  );
}

function ScheduleView({ posts, db, appId }) {
  const [filter, setFilter] = useState('all'); // all, pending, approved, published

  const filteredPosts = useMemo(() => {
    if (filter === 'all') return posts;
    return posts.filter(p => p.status === filter);
  }, [posts, filter]);

  const updatePostStatus = async (id, newStatus, extraData = {}) => {
    try {
      const postRef = doc(db, 'artifacts', appId, 'public', 'data', 'fpc_social_posts', id);
      await updateDoc(postRef, {
        status: newStatus,
        ...extraData
      });
    } catch (err) {
      console.error("Error actualizando documento", err);
      alert("Error al actualizar. Revisa la consola.");
    }
  };

  const deletePost = async (id) => {
    if(!window.confirm("¿Seguro que deseas eliminar esta publicación?")) return;
    try {
      await deleteDoc(doc(db, 'artifacts', appId, 'public', 'data', 'fpc_social_posts', id));
    } catch (err) {
      console.error("Error borrando", err);
    }
  };

  // Función simulada para "publicar ahora"
  const handlePublishNow = (id, platform, content) => {
    if (platform === 'whatsapp') {
      // Simular copiar al portapapeles y avisar
      navigator.clipboard.writeText(content);
      alert("Texto copiado al portapapeles. ¡Abre WhatsApp Web y pégalo en tu lista de difusión!");
    } else {
      alert("Simulando envío a API de Facebook/Instagram/X...\n¡Publicado con éxito!");
    }
    updatePostStatus(id, 'published', { publishedAt: Date.now() });
  };

  return (
    <div className="max-w-5xl mx-auto">
      <div className="flex flex-col md:flex-row md:items-center justify-between mb-8 gap-4">
        <div>
          <h2 className="text-2xl font-bold text-stone-800">Calendario y Aprobación</h2>
          <p className="text-stone-500">Gestiona el flujo de las publicaciones de la Fundación.</p>
        </div>
        
        <div className="flex bg-white rounded-lg shadow-sm border border-stone-200 p-1">
          {['all', 'pending', 'approved', 'published'].map(f => (
            <button
              key={f}
              onClick={() => setFilter(f)}
              className={`px-4 py-2 rounded-md text-sm font-medium transition-colors ${
                filter === f ? 'bg-emerald-100 text-emerald-800' : 'text-stone-500 hover:bg-stone-50'
              }`}
            >
              {f === 'all' && 'Todos'}
              {f === 'pending' && 'Borradores'}
              {f === 'approved' && 'Aprobados'}
              {f === 'published' && 'Histórico'}
            </button>
          ))}
        </div>
      </div>

      <div className="space-y-4">
        {filteredPosts.length === 0 ? (
          <div className="text-center py-12 bg-white rounded-xl border border-stone-200 border-dashed">
            <Calendar className="w-12 h-12 text-stone-300 mx-auto mb-3" />
            <p className="text-stone-500">No hay publicaciones en esta categoría.</p>
          </div>
        ) : (
          filteredPosts.map(post => (
            <PostCard 
              key={post.id} 
              post={post} 
              onApprove={() => updatePostStatus(post.id, 'approved', { scheduledDate: Date.now() + 86400000 })} // Programa para mañana simulado
              onPublish={() => handlePublishNow(post.id, post.platform, post.content)}
              onDelete={() => deletePost(post.id)}
            />
          ))
        )}
      </div>
    </div>
  );
}

function PostCard({ post, onApprove, onPublish, onDelete }) {
  const isPending = post.status === 'pending';
  const isApproved = post.status === 'approved';
  const isPublished = post.status === 'published';

  const statusColors = {
    pending: 'bg-amber-100 text-amber-800 border-amber-200',
    approved: 'bg-emerald-100 text-emerald-800 border-emerald-200',
    published: 'bg-blue-100 text-blue-800 border-blue-200'
  };

  const statusLabels = {
    pending: 'Borrador / Pendiente',
    approved: 'Aprobado / Programado',
    published: 'Publicado'
  };

  return (
    <div className="bg-white rounded-xl shadow-sm border border-stone-200 overflow-hidden flex flex-col md:flex-row">
      {/* Indicador de Canal */}
      <div className={`w-full md:w-32 flex flex-row md:flex-col items-center justify-center p-4 border-b md:border-b-0 md:border-r border-stone-100 ${post.platform === 'whatsapp' ? 'bg-green-50 text-green-700' : 'bg-blue-50 text-blue-700'}`}>
        {post.platform === 'whatsapp' ? <Smartphone className="w-8 h-8 mb-2" /> : <Share2 className="w-8 h-8 mb-2" />}
        <span className="text-xs font-bold uppercase tracking-wider text-center">
          {post.platform === 'whatsapp' ? 'WhatsApp' : 'Redes Soc.'}
        </span>
      </div>
      
      {/* Contenido */}
      <div className="p-6 flex-1 flex flex-col">
        <div className="flex justify-between items-start mb-4">
          <span className={`px-3 py-1 rounded-full text-xs font-bold border ${statusColors[post.status]}`}>
            {statusLabels[post.status]}
          </span>
          <span className="text-xs text-stone-400">
            Creado: {new Date(post.createdAt).toLocaleDateString('es-ES')}
          </span>
        </div>
        
        <div className="text-stone-800 whitespace-pre-wrap text-sm flex-1 font-medium bg-stone-50 p-4 rounded-lg border border-stone-100">
          {post.content}
        </div>

        {/* Acciones */}
        <div className="mt-4 pt-4 border-t border-stone-100 flex flex-wrap gap-2 justify-end">
          <button onClick={onDelete} className="p-2 text-stone-400 hover:text-red-500 transition-colors" title="Eliminar">
            <Trash2 className="w-5 h-5" />
          </button>
          
          {isPending && (
            <button 
              onClick={onApprove}
              className="flex items-center px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-bold rounded-md transition-colors"
            >
              <CheckCircle className="w-4 h-4 mr-2" /> Aprobar & Programar
            </button>
          )}

          {isApproved && (
            <button 
              onClick={onPublish}
              className="flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold rounded-md transition-colors"
            >
              <Send className="w-4 h-4 mr-2" /> 
              {post.platform === 'whatsapp' ? 'Publicar (Copiar)' : 'Forzar Publicación Ahora'}
            </button>
          )}
        </div>
      </div>
    </div>
  );
}

