function LoginScreen({ onLogin }) {
  return (
    <div className="min-h-screen bg-stone-100 flex items-center justify-center p-4">
      <div className="bg-white p-8 rounded-2xl shadow-xl max-w-md w-full text-center border-t-4 border-emerald-600">
        <div className="w-20 h-20 bg-emerald-100 rounded-full flex items-center justify-center mx-auto mb-6">
          <Share2 className="w-10 h-10 text-emerald-700" />
        </div>
        <h1 className="text-2xl font-bold text-stone-800 mb-2">Fundació Pere Casaldàliga</h1>
        <p className="text-stone-500 mb-8">Gestor Inteligente de Redes Sociales y Difusión</p>
        
        <button 
          onClick={onLogin}
          className="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 px-4 rounded-lg transition-colors flex items-center justify-center"
        >
          <span>Acceso Privado CM</span>
